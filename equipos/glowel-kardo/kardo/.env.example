# Kardo: variables de entorno locales (copia este archivo a .env).
# Solo valores locales o de prueba: nunca credenciales de producción aquí.
# Qué es cada variable, quién la lee y de dónde se saca:
#   Docs/engineering/27-variables-de-entorno.md
#
# Convenciones:
# - Una variable vacía cuenta como «no definida» (las APIs usan su valor por defecto).
# - Lo que empieza con VITE_ se compila dentro del panel o de Operations: es
#   PÚBLICO. Nunca pongas un secreto con VITE_.
# - El resto lo leen las APIs (Customer API y Staff API) o los scripts.
# - Vite y los scripts expanden ${OTRA_VARIABLE}; las APIs (node --env-file) no.
# - Los Workers de Cloudflare NO leen este archivo: sus valores van en su
#   wrangler.jsonc (vars) y con `wrangler secret put` (lista al final).

# ---------------------------------------------------------------------------
# Entorno, puertos y orígenes
# ---------------------------------------------------------------------------
# local | development | test | production
KARDO_ENV=local
CUSTOMER_API_PORT=3001
STAFF_API_PORT=3002
# Origen del panel del cliente y de Operations (CORS de cada API).
CUSTOMER_APP_ORIGIN=http://localhost:5173
OPERATIONS_APP_ORIGIN=http://localhost:5174
# Dirección de escucha. Vacía: 127.0.0.1 en local y 0.0.0.0 en contenedores.
CUSTOMER_API_HOST=
STAFF_API_HOST=
# Saltos de proxy confiables para la IP del cliente (límites de uso): 1 en Cloud Run.
TRUST_PROXY_HOPS=0
# debug | info | warn | error
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Supabase (base de datos y Auth)
# ---------------------------------------------------------------------------
# Bases para expandir abajo (${SUPABASE_URL}). Panel de Supabase → Project Settings → API.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Emisor de los JWT: ${SUPABASE_URL}/auth/v1
SUPABASE_JWT_ISSUER=
# Audiencia de los JWT de clientes (casi nunca cambia).
SUPABASE_JWT_AUDIENCE=authenticated
# Customer API: login de mínimo privilegio kardo_customer_api_runtime (por el pooler).
SUPABASE_DATABASE_URL=
# Staff API: login de mínimo privilegio kardo_staff_api_runtime (por el pooler).
STAFF_DATABASE_URL=
# Solo scripts (prepare-*, seed-demo, video): conexión de administrador. Nunca en una API.
SUPABASE_ADMIN_DATABASE_URL=

# ---------------------------------------------------------------------------
# Panel del cliente y Operations (PÚBLICAS: se compilan en el navegador)
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=${SUPABASE_URL}
VITE_SUPABASE_PUBLISHABLE_KEY=${SUPABASE_PUBLISHABLE_KEY}
VITE_CUSTOMER_API_URL=http://localhost:3001
VITE_STAFF_API_URL=http://localhost:3002
# Origen público permanente del Resolver: de aquí salen el contenido NFC y los QR.
VITE_TAP_RESOLVER_URL=https://kardo-poa-test-resolver.glowel-dev.workers.dev
# Origen permitido para subir archivos (CSP). Vacía: el origen de ASSET_WORKER_URL.
VITE_ASSET_UPLOAD_ORIGIN=
# Estado del servicio (ADR 022), p. ej. https://kardo-poa-test-status.glowel-dev.workers.dev
# Vacía en desarrollo: usa el Worker local http://127.0.0.1:8797.
VITE_STATUS_URL=
# Sitio público (enlaces a Términos y precios). Vacía en local: localhost:5177.
VITE_WEBSITE_URL=
# "true" corre el panel con datos de ejemplo, sin backend (solo local).
VITE_DEMO_MODE=false

# ---------------------------------------------------------------------------
# Workers de Cloudflare que llaman las APIs
# ---------------------------------------------------------------------------
# Resolver y su llave de publicación (igual al secreto PUBLISH_COMMAND_KEY del Resolver).
TAP_RESOLVER_URL=https://kardo-poa-test-resolver.glowel-dev.workers.dev
PUBLISH_COMMAND_KEY=
# El API despierta al Publisher justo después de encolar una publicación.
PUBLISHER_URL=https://kardo-poa-test-publisher.glowel-dev.workers.dev
# Solo Staff API: suspensión de Touchpoints (igual al secreto SUSPENSION_COMMAND_KEY del Resolver).
SUSPENSION_COMMAND_KEY=
# Assets Worker (R2): dirección y llave compartida para firmar subidas (igual a su secreto).
ASSET_WORKER_URL=
ASSET_UPLOAD_SIGNING_KEY=

# ---------------------------------------------------------------------------
# Analítica (Workers Analytics Engine, API SQL)
# ---------------------------------------------------------------------------
# Cloudflare → Account ID; token con permiso Account → Account Analytics → Read.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ANALYTICS_API_TOKEN=
# Igual al dataset del binding analytics_engine_datasets del Resolver.
TAP_ANALYTICS_DATASET=kardo_poa_test_taps
# Valor que el Resolver escribe como blob4 (su KARDO_ENV).
TAP_ANALYTICS_ENVIRONMENT=test

# ---------------------------------------------------------------------------
# Leads
# ---------------------------------------------------------------------------
# Llave de 32 bytes base64url, igual al secreto LEAD_WEBHOOK_KEY del Worker de analítica.
LEAD_WEBHOOK_KEY=
# "true" cuando el Worker de analítica tenga RESEND_API_KEY y LEAD_EMAIL_FROM.
LEAD_EMAIL_AVAILABLE=false

# ---------------------------------------------------------------------------
# Correo de salida (Resend)
# ---------------------------------------------------------------------------
# Sin RESEND_API_KEY no sale ningún correo: las invitaciones se comparten con un enlace.
RESEND_API_KEY=
# Remitente de invitaciones, p. ej. "Kardo <invitaciones@tu-dominio>".
INVITATION_EMAIL_FROM=
# Remitente de avisos de cobro (contrato, renovación, cancelación), p. ej.
# "Kardo <facturacion@tu-dominio>". Vacía: usa INVITATION_EMAIL_FROM.
BILLING_EMAIL_FROM=

# ---------------------------------------------------------------------------
# Suscripciones con Stripe (ADR 019 y 020, runbook 16-billing-stripe.md)
# ---------------------------------------------------------------------------
# Solo modo prueba en desarrollo (sk_test_/rk_test_). Sin la llave, los endpoints
# de cobro responden 503 BILLING_UNAVAILABLE. En producción, cada API su llave restringida.
STRIPE_SECRET_KEY=
# Local: lo imprime `stripe listen --forward-to localhost:3001/v1/billing/stripe/webhook`.
STRIPE_WEBHOOK_SECRET=
# Los imprime scripts/stripe/setup-billing.mts: tasa "IVA 16%" incluida y logo e ícono de Checkout.
STRIPE_TAX_RATE_ID=
STRIPE_BRAND_LOGO_FILE_ID=
STRIPE_BRAND_ICON_FILE_ID=
# "true" pide tarjeta incluso en la prueba (por defecto, prueba sin tarjeta).
STRIPE_TRIAL_REQUIRES_CARD=false
# "true" exige la casilla de Términos en Checkout (LFPC art. 76 Bis). Obligatorio antes de cobrar.
STRIPE_REQUIRE_TERMS_CONSENT=false
# Checkout dentro del panel (por defecto, Checkout alojado de Stripe). Llave pública del mismo modo.
VITE_STRIPE_EMBEDDED_CHECKOUT=false
STRIPE_PUBLISHABLE_KEY=
# Página pública de Términos de Suscripción enlazada en cada aviso, p. ej. https://tu-dominio/terminos
BILLING_TERMS_URL=
# Llave de la tarea horaria POST /internal/billing/tick (pg_cron la manda; igual al
# secreto kardo_billing_cron_key del Vault de Supabase). Vacía: la ruta es 404.
BILLING_CRON_KEY=
# Prueba de Kardo al terminar el alta (ADR 020): días (0 la apaga) y plan por defecto.
BILLING_TRIAL_DAYS=15
BILLING_TRIAL_PLAN=profesional
# Pausa de páginas por cobro (ADR 020 §4): igual al secreto BILLING_COMMAND_KEY del
# Resolver y distinta de PUBLISH_COMMAND_KEY y SUSPENSION_COMMAND_KEY.
BILLING_COMMAND_KEY=
# Solo para pausar contra un Resolver local (video, pruebas). Vacía: TAP_RESOLVER_URL.
BILLING_RESOLVER_URL=
# Borrado a los 90 días (ADR 020): "dry-run" solo cuenta, "true" borra. Apagado hasta
# que el dueño decida, después del abogado.
BILLING_DELETE_ENABLED=false

# ---------------------------------------------------------------------------
# CFDI con Facturapi (ADR 020 §6)
# ---------------------------------------------------------------------------
# sk_test_ crea CFDI de prueba sin timbrar; sk_live_ timbra. Vacía: se emiten en el portal del SAT.
FACTURAPI_KEY=

# ---------------------------------------------------------------------------
# IA de Kardo (Estudio, modo HTML y «Pregúntale a Kardo»)
# ---------------------------------------------------------------------------
# Consola de Anthropic (workspace propio con tope de gasto). Vacía: la IA queda apagada.
ANTHROPIC_API_KEY=
# Modelo de «Pregúntale a Kardo».
HELP_ASSISTANT_MODEL=claude-haiku-4-5
# Modelo del Estudio y del modo HTML.
CUSTOM_HTML_AI_MODEL=claude-sonnet-5
# anthropic | dev-bridge. Vacía: anthropic si hay llave; dev-bridge si hay KARDO_AI_BRIDGE_DIR.
CUSTOM_HTML_AI_PROVIDER=
# "false" apaga la IA de Kardo sin tocar lo demás.
CUSTOM_HTML_AI_ENABLED=
# Tope de gasto global por día UTC, en dólares.
CUSTOM_HTML_AI_DAILY_BUDGET_USD=10
# Solo desarrollo local (se niega a arrancar en producción): carpeta absoluta del puente.
KARDO_AI_BRIDGE_DIR=
KARDO_AI_BRIDGE_TIMEOUT_MS=240000

# ---------------------------------------------------------------------------
# Estado del servicio (ADR 022)
# ---------------------------------------------------------------------------
# Las dos llaves las genera `node scripts/dev/status-keys.mjs` (sin mostrarlas).
# Staff API → Worker de estado (/internal/*), p. ej. https://kardo-poa-test-status.glowel-dev.workers.dev
# STATUS_COMMAND_KEY es igual al secreto del mismo nombre del Worker.
STATUS_URL=
STATUS_COMMAND_KEY=
# Worker de estado → Customer API (GET /health/ready). Igual al secreto STATUS_PROBE_KEY del Worker.
STATUS_PROBE_KEY=

# ---------------------------------------------------------------------------
# Cuentas y opciones de los scripts de prueba (solo kardo-dev)
# ---------------------------------------------------------------------------
# Las generan scripts/e2e/prepare-dev-accounts.mjs y prepare-staff.mjs.
E2E_OWNER_EMAIL=
E2E_OWNER_PASSWORD=
E2E_MEMBER_EMAIL=
E2E_MEMBER_PASSWORD=
E2E_STAFF_EMAIL=
E2E_STAFF_PASSWORD=
E2E_STAFF_TOTP_SECRET=
# scripts/demo/seed-demo.mjs: contraseña de la cuenta demo (vacía: genera una).
DEMO_PASSWORD=
# Las direcciones de las E2E (E2E_API_URL, E2E_STAFF_API_URL, E2E_STATUS_URL) y de
# seed-demo (DEMO_API_URL) se pasan en la línea de comandos, no aquí.

# ---------------------------------------------------------------------------
# Workers de Cloudflare (NO se leen de aquí; van en wrangler.jsonc o como secreto)
# ---------------------------------------------------------------------------
# Resolver:  vars KARDO_ENV, KARDO_DIAGNOSTICS, TURNSTILE_SITE_KEY (opcional)
#            secretos PUBLISH_COMMAND_KEY, SUSPENSION_COMMAND_KEY, BILLING_COMMAND_KEY,
#            LEAD_INTAKE_KEY, TURNSTILE_SECRET_KEY (opcional)
# Publisher: secreto PUBLISH_COMMAND_KEY; Hyperdrive y servicio RESOLVER en wrangler.jsonc
# Analytics: secretos LEAD_INTAKE_KEY, LEAD_WEBHOOK_KEY, RESEND_API_KEY y LEAD_EMAIL_FROM (opcionales)
# Assets:    var CUSTOMER_APP_ORIGIN; secreto ASSET_UPLOAD_SIGNING_KEY; buckets R2 en wrangler.jsonc
# Estado:    vars CUSTOMER_API_URL, CUSTOMER_APP_URL, RESOLVER_URL, STATUS_PROBE_PUBLIC_ID,
#            STATUS_PROBE_MARKER; secretos STATUS_COMMAND_KEY, STATUS_PROBE_KEY
