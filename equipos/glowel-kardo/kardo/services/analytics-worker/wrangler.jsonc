{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "kardo-poa-test-analytics",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": {
    "KARDO_ENV": "test"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "triggers": {
    "crons": ["17 */6 * * *"]
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "a446e2f0b9de49eeb1009b91aa2412c2"
    }
  ],
}
