{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // Solo para las pruebas: sin bindings a otros Workers ni proveedores.
  "name": "kardo-test-status",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-14",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "KARDO_ENV": "test",
    "CUSTOMER_API_URL": "",
    "CUSTOMER_APP_URL": "",
    "RESOLVER_URL": "",
    "STATUS_PROBE_PUBLIC_ID": "",
    "STATUS_PROBE_MARKER": "",
    "PROVIDERS_ENABLED": "false"
  },
  "durable_objects": {
    "bindings": [{ "name": "STATUS_STATE", "class_name": "StatusState" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["StatusState"] }]
}
